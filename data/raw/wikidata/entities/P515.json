  "datatype": "wikibase-item",
  "descriptions": {
    "ca": {
      "language": "ca",
      "value": "Q11432 = gas, Q11435 = líquid, Q11438 = sòlid, Q10251 = plasma"
    },
    "de": {
      "language": "de",
      "value": "Q11432 = Gas, Q11435 = Flüssigkeit, Q11438 = Festkörper, Q10251 = Plasma"
    },
    "el": {
      "language": "el",
      "value": "ένδειξη της κατάστασης ή φάσης της ύλης στην οποία έγινε η μέτρηση, Χρησιμοποιείστε Q11432 = αέριο, Q11435 = υγρό, Q11438 = στερεό, Q10251 = πλάσμα"
    },
    "en": {
      "language": "en",
      "value": "state or phase of the matter at which the measure was made"
    },
    "es": {
      "language": "es",
      "value": "estado o fase de la materia: gas (Q11432), líquido (Q11435), sólido (Q11438), plasma (Q10251)"
    },
    "ext": {
      "language": "ext",
      "value": "estau o fasi dela materia: gas (Q11432), líquiu (Q11435), sóliu (Q11438), xugu (Q10251)"
    },
    "fa": {
      "language": "fa",
      "value": "حالتی از ماده که اندازه‌گیری‌ مورد نظر در آن حالت ماده انجام گرفته است. مقادیر مجاز این خصوصیت عبارتند از Q11432(گاز)، Q11435(مایع)، Q11438(جامد)، Q10251(سیال)"
    },
    "fr": {
      "language": "fr",
      "value": "état de la matière pour cette mesure (gaz, liquide, solide... Voir page de discussion)"
    },
    "gl": {
      "language": "gl",
      "value": "estado ou fase da materia: gas (Q11432), líquido (Q11435), sólido (Q11438), plasma (Q10251)"
    },
    "he": {
      "language": "he",
      "value": "הפאזה שהחומר היה מצוי בה בזמן המדידה"
    },
    "hu": {
      "language": "hu",
      "value": "az a halmazállapot, ami az adott mérési értékhez tartozik - gáz (Q11432), folyadék (Q11435), szilárd (Q11438), plazma (Q10251)"
    },
    "id": {
      "language": "id",
      "value": "keadaan atau fase materi saat pengukuran dibuat"
    },
    "ig": {
      "language": "ig",
      "value": "steeti ma ọ bụ akụkụ nke mata ahụ ebe emere nhata"
    },
    "it": {
      "language": "it",
      "value": "indicazione dello stato o della fase del soggetto al momento della misurazione. Usare Q11432 = gas, Q11435 = liquido, Q11438 = solido, Q10251 = plasma"
    },
    "ja": {
      "language": "ja",
      "value": "物質の状態が「気体 (Q11432)」か「液体 (Q11435)」か「固体 (Q114380)」、あるいは「プラズマ (Q10251)」のどれであるかを示します。"
    },
    "ko": {
      "language": "ko",
      "value": "Q11432 = 기체, Q11435 = 액체, Q11438 = 고체, Q10251 = 플라즈마"
