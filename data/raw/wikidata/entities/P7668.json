  "datatype": "quantity",
  "descriptions": {
    "ast": {
      "language": "ast",
      "value": "propiedá pa indicar un númberu de páxina d'un ficheru pdf o asemeyáu. númberu de páxina, dacuando, ye diferente de la numberación del testu reproducida nel documentu. Tendría de permitir enllazar a la páxina cuando se combina cola URL del ficheru."
    },
    "be-tarask": {
      "language": "be-tarask",
      "value": "уласьцівасьць для пазначэньня нумару старонкі, напрыклад, у PDF-файле"
    },
    "ca": {
      "language": "ca",
      "value": "propietat per indicar un número de pàgina d'un fitxer pdf o similar. El número de pàgina de vegades és diferent de la numeració del text reproduït al document. Hauria de permetre enllaçar la pàgina quan es combina amb l'URL del fitxer"
    },
    "de": {
      "language": "de",
      "value": "Seitenangabe für eine pdf- oder ähnliche Datei. Diese kann von der Seitenzählung des in der Datei reproduzierten Dokumentes abweichen. Mit dieser Eigenschaft kann auf die relevante Seite innerhalb der Datei verlinkt werden."
    },
    "en": {
      "language": "en",
      "value": "property to indicate a page number of a pdf file or similar. The page number is sometimes different from the numbering of the text reproduced in the document. Should allow to link the page when combined with the file URL"
    },
    "es": {
      "language": "es",
      "value": "propiedad para indicar el número de página de un archivo digital. El número de página es diferente a veces de la numeración del texto reproducido en el archivo digital. Debe permitir enlazar la página cuando se combina con la URL del archivo."
    },
    "ext": {
      "language": "ext",
      "value": "propiedá pa endical el númiru de página dun archivu degital. A vezis el númiru de página es deferenti dela numiración del testu nel archivu degital. Devi premitil atijal la página quandu se combina cona URL de l'archivu"
    },
    "fr": {
      "language": "fr",
      "value": "propriété pour indiquer le numéro de page d'un objet dématérialisé dans un fichier. Le numéro de page est parfois différent de la numérotation du document reproduit. Doit permettre de lier la page lorsqu'elle est combinée à l'URL du fichier."
    },
    "ru": {
      "language": "ru",
      "value": "свойство для указания страницы PDF-файла или аналогичного. Номер страницы иногда отличается от страницы текста, указанного в документе. Должно позволять указать страницу в сочетании с URL-адресом файла"
    },
    "tr": {
      "language": "tr",
      "value": "pdf dosyasının veya benzerinin sayfa numarasını gösteren özellik. Sayfa numarası bazen belgede yeniden üretilen metnin numaralandırmasından farklıdır. Dosya URL'si ile birleştirildiğinde sayfanın bağlanmasına izin vermelidir"
    },
    "tt": {
      "language": "tt",
      "value": "PDF файлының яки башка шуның ищенең битен билгеләүче үзлек. Битнең номеры документтагы текст битендәгесеннән аерылырга мөмкин. Битне файлның URL-юлламасы белән билгеләргә мөмкин булырга тиеш"
    },
    "uk": {
      "language": "uk",
      "value": "властивість для вказання номера сторінки файлу pdf чи подібного. Номер сторінки файлу іноді відрізняється від нумерації сторінок тексту, відтвореного в документі. Треба дозволити посилання на сторінку в поєднанні з URL-адресою файлу"
    }
  },
