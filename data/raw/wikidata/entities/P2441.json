  "datatype": "monolingualtext",
  "descriptions": {
    "ar": {
      "language": "ar",
      "value": "ترجمة مباشرة أو حرفية لاسم أو عبارة (لوصف اسم أو عنوان أو نقش أو اقتباس)"
    },
    "be-tarask": {
      "language": "be-tarask",
      "value": "літаральны пераклад назвы ці фразы (кваліфікатар)"
    },
    "ca": {
      "language": "ca",
      "value": "traducció, paraula per paraula, d'un nom o d'una frase (qualificador per a un nom, títol, inscripció, o cita)"
    },
    "cs": {
      "language": "cs",
      "value": "přímý doslovný překlad (slovo od slova) daného názvu nebo fráze"
    },
    "da": {
      "language": "da",
      "value": "ord-for-ord oversættelse"
    },
    "de": {
      "language": "de",
      "value": "direkte Wort-für-Wort-Übersetzung eines Namens oder einer Phrase (als Qualifier für Namens-, Titel-, Beschriftungs- und Zitat-Eigenschaften)"
    },
    "en": {
      "language": "en",
      "value": "direct or word-for-word translation of a name or phrase (qualifier for name, title, inscription, and quotation properties)"
    },
    "es": {
      "language": "es",
      "value": "traducción palabra por palabra de un nombre o una frase"
    },
    "ext": {
      "language": "ext",
      "value": "tradución parabra por parabra dun nombri o una frasi"
    },
    "fa": {
      "language": "fa",
      "value": "ترجمه ادبی واژه به واژه (به عنوان گستره‌نما برای خصوصیت‌های نام، عنوان، ...)"
    },
    "fi": {
      "language": "fi",
      "value": "suora sanasta sanaan käännös nimestä tai fraasista (tarkenne nimi, otsikko ja lainaus ominaisuuksille)"
    },
    "fr": {
      "language": "fr",
      "value": "traduction directe ou mot-à-mot d'un nom ou d'une phrase (qualificatif pour une propriété de nom, de titre, d'inscription et de citation)"
    },
    "gl": {
      "language": "gl",
      "value": "tradución, palabra por palabra, dun nome ou frase (cualificador para nomes, títulos, inscricións ou citas)"
    },
    "hi": {
      "language": "hi",
      "value": "शब्दानुवाद या प्रत्यक्ष अनुवाद (नाम, शीर्षक, शिलालेख, और उद्धरण गुणों के लिए योग्यता)"
    },
