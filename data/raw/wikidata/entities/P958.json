  "datatype": "string",
  "descriptions": {
    "ba": {
      "language": "ba",
      "value": "мәғлүмәт битендә йәки документта ҡайҙа табылыуы тураһында күрһәткес"
    },
    "be-tarask": {
      "language": "be-tarask",
      "value": "параграф, калёнка ці іншы віды спэцыяльнай пазнакі, дзе знайсьці зьвесткі на старонцы альбо ў дакумэнце"
    },
    "ca": {
      "language": "ca",
      "value": "paràgraf o un altre tipus d’indicació especial per trobar informació en una pàgina o en un document (textos legals et al.)"
    },
    "cs": {
      "language": "cs",
      "value": "označení relevantní části dokumentu (např. u citace právních textů)"
    },
    "dag": {
      "language": "dag",
      "value": "Yaɣili, bɛi yaɣa yaɣa Zaŋ chaŋ Cundunima bɛi sabbu shɛi"
    },
    "de": {
      "language": "de",
      "value": "Angabe zum Auffinden einer Aussage oder Textstelle (für Kapitel siehe P792)"
    },
    "el": {
      "language": "el",
      "value": "παράγραφος, στήλη, ή άλλο είδος ειδικής επισήμανσης όπου βρίσκεται μια πληροφορία σε μια σελίδα ή έγγραφο (νομικά κείμενα κ.α.)"
    },
    "en": {
      "language": "en",
      "value": "paragraph, or other kind of special indication to find information on a page or on a document"
    },
    "eo": {
      "language": "eo",
      "value": "indiko por trovi informon aŭ tekstopecon"
    },
    "es": {
      "language": "es",
      "value": "párrafo o indicador especial para encontrar información en una página o en un documento"
    },
    "ext": {
      "language": "ext",
      "value": "endicaol especial p'atopal inhormación nuna página o nun decumentu"
    },
    "fr": {
      "language": "fr",
      "value": "paragraphe ou autre indication permettant de trouver une information sur une page ou un document"
    },
    "gl": {
      "language": "gl",
      "value": "parágrafo ou outro tipo de indicación especial para atopar información nunha páxina ou nun documento (textos legais et al.)"
    },
    "he": {
      "language": "he",
      "value": "פסקה, טור, עמודה, הערת שוליים או סוג סימון אחר לאיתור מידע בדף או במסמך"
    },
    "hsb": {
      "language": "hsb",
      "value": "podaće za namakanje wuprajenja"
    },
    "hy": {
      "language": "hy",
      "value": "հատուկ նշում էջում կամ փաստաթղթում տեղեկատվություն փնտրելու համար (իրավաբանական տեքստեր և այլն)"
    },
    "id": {
      "language": "id",
      "value": "paragraf, kolom, atau penunjuk khusus lain untuk menemukan informasi dalam sebuah halaman atau dokumen, dll."
    },
    "ig": {
      "language": "ig",
      "value": "paragraf, ma ọ bụ ụdị ihe ngosi pụrụ iche ọzọ ịchọta ozi na ibe ma ọ bụ na akwụkwọ (edemede iwu wdg)"
    },
    "io": {
      "language": "io",
      "value": "paragrafo od altra specala indiko pri quale trovar informo en pagino od en dokumento (legala texti, edc.)"
    },
    "it": {
      "language": "it",
      "value": "paragrafo, o altro tipo di indicazione speciale per trovare informazioni su una pagina o su un documento (testi legali, etc...)"
    },
    "ja": {
      "language": "ja",
      "value": "情報が記載されている、典拠内の章・節・項、記事名、法的文書の条項番号、百科事典の項目名など"
    },
    "kaa": {
      "language": "kaa",
      "value": "paragraf yamasa bir bettegi yaki hújjettegi (huqıqıy tekstler h.t.b) maǵlıwmattı tabıwda basqa túrdegi arnawlı kórsetkish"
    },
    "ko": {
      "language": "ko",
      "value": "문서 전체나 특정 페이지에서 특정한 문단을 착기 위한 지시자"
    },
    "oc": {
      "language": "oc",
      "value": "seccion, paragraf o autre tipe d'inidicacion especiala per identificar informacions sus un document"
    },
    "pl": {
      "language": "pl",
      "value": "akapit lub inne oznaczenie miejsca umieszczenia informacji w obrębie publikacji (dla rozdziałów stosuje się P792)"
    },
    "pnb": {
      "language": "pnb",
      "value": "حوالے چ جز، دفعہ، حصہ وغیرہ"
    },
    "pt": {
      "language": "pt",
      "value": "parágrafo ou outra indicação para encontrar informação em uma página ou documento (ex: textos jurídicos etc)"
    },
    "ro": {
      "language": "ro",
      "value": "secțiune, verset, paragraf sau alte indicații care permit găsirea unei informații dintr-o pagină sau document"
    },
    "ru": {
      "language": "ru",
      "value": "указатель на то, где найти сведения на странице или в документе"
    },
    "scn": {
      "language": "scn",
      "value": "paràgrafu, capìtulu, comma o suttadivisioni quali è jè dûn ducumentu unni si trova na nfurmazzioni"
    },
    "sl": {
      "language": "sl",
      "value": "odstavek, stolpec ali druga oblika posebne označitve za lažje iskanje informacije na strani ali v dokumentu (legal texts et al.)"
    },
    "sq": {
      "language": "sq",
      "value": "paragraf, ose lloj tjetër treguesi të veçantë për të gjetur informacion në një faqe ose në një dokument (tekste ligjore etj.)"
    },
    "sv": {
      "language": "sv",
      "value": "specifikation för att hitta ett uttalande eller en text på en sida eller i ett dokument (för kapitel se P792)"
    },
    "tr": {
      "language": "tr",
      "value": "bir belgede ya da sayfada ilgili öge hakkında bilgi bulunabilecek başka bir gösterge"
    },
    "uk": {
