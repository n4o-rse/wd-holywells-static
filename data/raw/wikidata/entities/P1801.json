  "descriptions": {
    "ca": {
      "language": "ca",
      "value": "imatge d'una placa o inscripció, per a tombes empreu P1442"
    },
    "cs": {
      "language": "cs",
      "value": "obrázek plakety nebo nápisu připomínající nebo zmiňující předmět. Pro hroby použijte obrázek hrobu (P1442)"
    },
    "de": {
      "language": "de",
      "value": "Bild einer Gedenktafel oder Inschrift, die an diese Entität erinnert oder sie erwähnt. Für Grabsteine P1442 benutzen"
    },
    "en": {
      "language": "en",
      "value": "image of plaque or inscription commemorating or mentioning the subject. For graves, use grave picture (P1442)"
    },
    "en-gb": {
      "language": "en-gb",
      "value": "image of plaque or inscription commemorating or mentioning the subject. For graves, use grave picture (P1442)"
    },
    "eo": {
      "language": "eo",
      "value": "bildo de plakedo aŭ surskribo memoriganta aŭ mencias la temon. Por tomboj, uzu tomban bildon (P1442)"
    },
    "es": {
      "language": "es",
      "value": "imagen de una placa o inscripción conmemorativa o que mencione al sujeto. Para tumbas, usar imagen de la tumba (P1442)"
    },
    "ext": {
      "language": "ext",
      "value": "imagi duna praca o escreción comemorativa o que mienti al endividu. Pa tumbas, gastal imagi dela tumba (P1442)"
    },
    "fi": {
