    },
    "ga": {
      "language": "ga",
      "value": "íomhá plaic nó inscríbhinn ag comóradh nó ag lua an ábhair. Le haghaidh uaigheanna, úsáid pictiúr uaighe (P1442)"
    },
    "gl": {
